{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "mentor-module/1",
  "title": "Blender Mentor module",
  "type": "object",
  "required": [
    "schema",
    "id",
    "version",
    "status",
    "kind",
    "domain",
    "intent",
    "coverage",
    "data",
    "rules",
    "unknown_policy"
  ],
  "additionalProperties": true,
  "properties": {
    "schema": {
      "const": "mentor-module/1"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Z]{2,4}-[0-9]{3}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "status": {
      "enum": [
        "experimental",
        "stable",
        "deprecated"
      ]
    },
    "kind": {
      "enum": [
        "reference",
        "procedure",
        "hybrid"
      ]
    },
    "domain": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "intent": {
      "type": "object",
      "required": [
        "include"
      ],
      "properties": {
        "include": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "keywords",
          "data_keys"
        ],
        "properties": {
          "keywords": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "data_keys": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "value",
          "unit"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "value": {},
          "unit": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "source_id": {
            "type": "string"
          },
          "source_type": {
            "enum": [
              "book",
              "code",
              "standard",
              "paper",
              "web",
              "draft"
            ]
          },
          "citation": {
            "type": "string"
          },
          "verification": {
            "enum": [
              "page-checked",
              "metadata-only",
              "pending"
            ]
          },
          "assumption": {
            "type": "boolean"
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          }
        },
        "anyOf": [
          {
            "required": [
              "source"
            ]
          },
          {
            "required": [
              "source_id"
            ]
          },
          {
            "required": [
              "assumption"
            ],
            "properties": {
              "assumption": {
                "const": true
              }
            }
          }
        ]
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "check",
          "severity"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "check": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "fail",
              "warn",
              "info"
            ]
          },
          "evidence": {
            "type": "string"
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unknown_policy": {
      "enum": [
        "block",
        "ask",
        "proceed_with_label"
      ]
    },
    "requires": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "conflicts_with": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "changelog": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "styles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "layouts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
