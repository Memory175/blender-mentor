{
  "version": "1.2.0",
  "suite_version": "V5.12.0",
  "always": [
    {
      "file": "references/main.md",
      "reason": "身份/边界/教学协议/交付闭环/模块注册表"
    },
    {
      "file": "references/rubric.md",
      "reason": "评分表/关键项/自评模板"
    }
  ],
  "on_demand": [
    {
      "file": "references/toolbox_text.md",
      "reason": "脚本/检查器/130 条误区/修复对话",
      "triggers": [
        "脚本",
        "bpy",
        "检查",
        "验收",
        "报错",
        "崩溃",
        "误区",
        "工具",
        "asset_gate",
        "envelope",
        "biomech"
      ]
    },
    {
      "file": "references/curriculum.md",
      "reason": "课程/作业/前测后测/教案",
      "triggers": [
        "教学",
        "课程",
        "作业",
        "练习",
        "前测",
        "后测",
        "上课",
        "备课",
        "Capstone",
        "周"
      ]
    }
  ],
  "modules": [
    {
      "id": "ESD-001",
      "file": "references/module-esd.md",
      "reason": "能量驱动的次级动画（形变/抖动/粒子/镜头）",
      "triggers": [
        "次级动画",
        "形变",
        "包络",
        "弹跳",
        "挤压",
        "拉伸",
        "镜头震动",
        "粒子",
        "ESD",
        "能量"
      ]
    },
    {
      "id": "BIO-001",
      "file": "references/module-biomechanics.md",
      "reason": "生物力学与运动解剖（人体/类人动画）",
      "triggers": [
        "人体",
        "类人",
        "角色动画",
        "走路",
        "行走",
        "跑步",
        "跑动",
        "跑跳",
        "起跳",
        "落地",
        "受击",
        "肌肉",
        "生物力学",
        "动力链",
        "BIO",
        "动作设计",
        "动作分析"
      ]
    },
    {
      "id": "ENG-001",
      "file": "references/module-engineering.md",
      "reason": "工业设计与可制造性（力学/制造/人体工学/装配）",
      "triggers": [
        "可制造",
        "制造",
        "工程审查",
        "壁厚",
        "拔模",
        "注塑",
        "铸造",
        "陶瓷",
        "3D打印",
        "3D 打印",
        "打印",
        "悬垂",
        "装配",
        "卡扣",
        "螺丝",
        "胶水",
        "一体化",
        "人体工学",
        "握持",
        "重心",
        "支撑面",
        "应力",
        "干涉",
        "碰撞",
        "倒扣",
        "DFM",
        "CNC",
        "钣金",
        "可装配"
      ]
    },
    {
      "id": "INT-001",
      "file": "references/module-int-001.md",
      "reason": "室内设计/内饰：中式风格两室两厅公寓（experimental）",
      "triggers": [
        "室内",
        "内饰",
        "室内设计",
        "室内建模",
        "中式",
        "新中式",
        "两室两厅",
        "公寓"
      ]
    }
  ],
  "tools": [
    {
      "file": "scripts/persona_lint.py",
      "when": "人设/套件交付前自检"
    },
    {
      "file": "scripts/selftest.py",
      "when": "工具链自检"
    },
    {
      "file": "scripts/expand_esd_spec.py",
      "when": "ESD 模板展开为可执行 spec"
    },
    {
      "file": "scripts/load_router.py",
      "when": "生成本次加载清单"
    },
    {
      "file": "scripts/sample_esd_from_blend.py",
      "when": "从 .blend 采样生成 ESD measured spec"
    },
    {
      "file": "scripts/curve_audit.py",
      "when": "曲线审计（插值/手柄统计）"
    },
    {
      "file": "scripts/render_probe.py",
      "when": "渲染探针（输出 //probe.png）"
    },
    {
      "file": "scripts/engineering_check.py",
      "when": "工程预检（稳定性/壁厚/拔模/悬垂/干涉）"
    },
    {
      "file": "scripts/preflight.py",
      "when": "模块预审闸门（proceed/proceed_core/ask/block）"
    },
    {
      "file": "scripts/module_lint.py",
      "when": "模块格式/证据/注册表检查"
    },
    {
      "file": "scripts/module_conflict.py",
      "when": "模块间冲突巡查"
    },
    {
      "file": "scripts/module_selftest.py",
      "when": "预审闸门回归"
    },
    {
      "file": "scripts/audit_claims.py",
      "when": "输出引用审计（数字必须可追溯）"
    },
    {
      "file": "scripts/module_gap.py",
      "when": "缺模块时生成缺口说明 + 可复制 Prompt + 并入步骤"
    },
    {
      "file": "scripts/source_audit.py",
      "when": "来源注册表审计（TTL/失效/withdrawn/缺 jurisdiction）"
    },
    {
      "file": "scripts/source_refresh.py",
      "when": "来源过期后查询官方页面/Crossref，只提议不自动替换"
    }
  ],
  "policy": [
    "先常驻主文档 + rubric；其余按任务触发词加载",
    "模块只在触发词命中时加载；同时最多加载 2 个模块",
    "超预算裁剪顺序：curriculum → toolbox → 非当前任务模块",
    "主文档与 rubric 永不裁剪",
    "开场把本次加载清单与预算告知用户"
  ],
  "token_estimate": {
    "method": "rough",
    "formula": "bytes/3",
    "note": "粗估，仅用于预算裁剪；中英混排实际会有偏差"
  }
}
